<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        命令模块 Bean 装配（单向 DAG，无循环依赖）：
        创建顺序：commandRegistry → commandEngine → commandAPI

        commandRegistry : 无依赖（最先创建）
        commandEngine   : 构造器依赖 commandRegistry（实现 PluginAware + CommandExecutor）
        commandAPI  : 构造器依赖 commandRegistry + commandEngine（最后创建）
    -->

    <!-- 路由注册表（内部）：控制器注册、模式匹配、特异性排序、分发执行 -->
    <bean class="io.github.JiangHu.jframe.command.routing.CommandRegistry" id="commandRegistry"/>

    <!-- 命令引擎（内部）：对接 Nukkit CommandMap，注册根命令并转发分发 -->
    <bean class="io.github.JiangHu.jframe.command.CommandEngine" id="commandEngine">
        <constructor-arg name="registry" ref="commandRegistry"/>
    </bean>

    <!-- 命令服务（公开入口）：register/unregister/scan 委托，bindPlugin 转发 -->
    <bean class="io.github.JiangHu.jframe.command.CommandAPI" id="commandAPI">
        <constructor-arg name="registry" ref="commandRegistry"/>
        <constructor-arg name="engine" ref="commandEngine"/>
    </bean>

</beans>
