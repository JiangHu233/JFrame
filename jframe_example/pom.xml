<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.JiangHu.jframe</groupId>
        <artifactId>JFrame</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jframe_example</artifactId>

    <properties>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          依赖 jframe_main：它会聚合引入 core / thread / form / event 全部子模块，
          因此本示例可以直接使用框架的所有服务（EventAPI / ViewAPI / ThreadAPI）。
        -->
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_main</artifactId>
            <version>1.0-SNAPSHOT</version>
            <!--
              provided：jframe_example 运行时 depend 前置插件 JFrame（jframe_main），
              由 JFrame 的类加载器统一加载框架类（jframe_command / jframe_ai / jframe_inventory 等），
              避免本插件重复 shade 框架类导致 Nukkit 多插件类加载器冲突
              （IllegalAccessError：同一框架类被两个 PluginClassLoader 各加载一份，
              外层类与内部类分属不同加载器时触发）。
              部署时需先放入 jframe_main.jar，再放入 jframe_example.jar。
            -->
            <scope>provided</scope>
        </dependency>

        <!-- spring 依赖 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>5.3.24</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>5.3.24</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <version>5.3.24</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
            <version>5.3.24</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
            <version>5.3.24</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!--
              maven-shade-plugin：把 jframe 各模块与 Spring 打包成单个可部署的插件 jar。
              Nukkit（服务端）与 Lombok（编译期）不打包；GUI 默认不打包（system 作用域）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- 由服务端提供 -->
                                    <exclude>cn.nukkit:Nukkit</exclude>
                                    <!-- 编译期注解处理器，运行时不需要 -->
                                    <exclude>org.projectlombok:lombok</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <!-- 合并 META-INF/services（Spring 等可能用到） -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- 合并 Spring 的 schema/handlers 映射，避免 XML 解析失败 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.handlers</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.schemas</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
