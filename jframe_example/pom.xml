<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.JiangHu.jframe</groupId>
        <artifactId>JFrame</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jframe_example</artifactId>

    <properties>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          依赖 jframe_main：它会聚合引入 core / thread / form / event 全部子模块，
          因此本示例可以直接使用框架的所有服务（EventAPI / ViewAPI / ThreadAPI）。
        -->
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_main</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!--
          fakeinventories：第三方假方块箱子库，用于对比演示。
          采用 system 作用域直接引用 libs/ 下的 jar，不安装到本地仓库。
          shade 插件默认不打包 system 作用域依赖——该 jar 本身是独立 Nukkit 插件，
          运行时需单独放入服务器 plugins 目录，故不打包进 jframe_example。
          ${maven.multiModuleProjectDirectory} 指向 reactor 根目录（JFrame/），从根目录构建时路径有效。

        <dependency>
            <groupId>com.nukkitx</groupId>
            <artifactId>fakeinventories</artifactId>
            <version>1.0.3-MOT-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${maven.multiModuleProjectDirectory}/libs/fakeinventories-1.0.3-MOT-SNAPSHOT.jar</systemPath>
        </dependency>
        -->

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!--
              maven-shade-plugin：把 jframe 各模块与 Spring 打包成单个可部署的插件 jar。
              Nukkit（服务端）与 Lombok（编译期）不打包；GUI 默认不打包（system 作用域）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- 由服务端提供 -->
                                    <exclude>cn.nukkit:Nukkit</exclude>
                                    <!-- 编译期注解处理器，运行时不需要 -->
                                    <exclude>org.projectlombok:lombok</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <!-- 合并 META-INF/services（Spring 等可能用到） -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- 合并 Spring 的 schema/handlers 映射，避免 XML 解析失败 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.handlers</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.schemas</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
