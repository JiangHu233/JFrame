<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        事件模块 Bean 装配（单向 DAG，无循环依赖）：
        创建顺序：eventEngine → handlerRegistry → eventAPI

        eventEngine   : 无依赖（最先创建）
        handlerRegistry : 构造器依赖 eventEngine
        eventAPI  : 构造器依赖 handlerRegistry + eventEngine（最后创建）
    -->

    <!-- 事件引擎（内部）：对接 Nukkit 底层事件系统，按类型订阅和分发 -->
    <bean class="io.github.JiangHu.jframe.event.EventEngine" id="eventEngine"/>

    <!-- 核心路由引擎：对象处理器注册、身份匹配、优先级分发 -->
    <bean class="io.github.JiangHu.jframe.event.routing.HandlerRegistry" id="handlerRegistry">
        <constructor-arg name="engine" ref="eventEngine"/>
    </bean>

    <!-- 事件服务（公开入口）：register/unregister/evict 委托给 handlerRegistry，subscribe 转发给 eventEngine -->
    <bean class="io.github.JiangHu.jframe.event.EventAPI" id="eventAPI">
        <constructor-arg name="handlerRegistry" ref="handlerRegistry"/>
        <constructor-arg name="engine" ref="eventEngine"/>
    </bean>

</beans>
