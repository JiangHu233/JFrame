<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        箱子界面模块 Bean 装配（单向 DAG，无循环依赖）：
        创建顺序：inventoryManager → inventoryAPI

        inventoryManager : 无依赖（最先创建）
        inventoryAPI     : 构造器依赖 inventoryManager（最后创建）
    -->

    <!-- 箱子界面管理器（内部）：监听 Nukkit 库存事件，路由到对应的 InventoryView -->
    <bean class="io.github.JiangHu.jframe.inventory.ui.manager.InventoryManager" id="inventoryManager"/>

    <!-- 箱子界面 API（公开入口）：openView/closeView/getView 委托给 inventoryManager -->
    <bean class="io.github.JiangHu.jframe.inventory.ui.InventoryAPI" id="inventoryAPI">
        <constructor-arg name="manager" ref="inventoryManager"/>
    </bean>

</beans>
