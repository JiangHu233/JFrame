<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.JiangHu.jframe</groupId>
        <artifactId>JFrame</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jframe_main</artifactId>

    <properties>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JFrame 框架模块：本模块聚合所有子模块，对外提供统一入口 -->
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_async</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_form</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_listener</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_command</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_inventory</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_data</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_ai</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_template</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_scoreboard_depend_template</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_title_depend_template</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_nbt</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_engine</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_floatingtext</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_logger</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_transform</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!--
              maven-shade-plugin：把 jframe 各子模块与保留的 Spring 工具库（core/expression）
              打包成单个可部署的「前置插件」jar。Nukkit（服务端）与 Lombok（编译期）不打包。
              产物 jframe_main.jar 可直接放入服务器 plugins 目录，供其他插件 depend 使用。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- 由服务端提供 -->
                                    <exclude>cn.nukkit:Nukkit</exclude>
                                    <!-- 编译期注解处理器，运行时不需要 -->
                                    <exclude>org.projectlombok:lombok</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <!-- 合并 META-INF/services -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!--
                                  -javaagent 可选预注入路径：agentmain/premain 双入口 +
                                  retransform 能力（TransformAgent；不配置时插件侧运行中自附加）
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>io.github.JiangHu.jframe.transform.agent.TransformAgent</Premain-Class>
                                        <Agent-Class>io.github.JiangHu.jframe.transform.agent.TransformAgent</Agent-Class>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <!--
                              ByteBuddy（jframe_transform 传递依赖）以原名打包：
                              shade 3.6.0 内置 ASM 不支持 JDK 24（v68）类文件，任何
                              relocation 都会触发全 jar ASM 改写而失败，故不 relocate。
                              冲突面：仅当其他插件自带 ByteBuddy 且经依赖链解析到
                              JFrame 加载器时才可能版本混淆（Nukkit 生态罕见）——
                              已列入模块 README 已知限制；后续 shade 支持更高类文件
                              版本后可补 relocate（pattern: net.bytebuddy. → shaded）。
                            -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
