<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.JiangHu.jframe</groupId>
        <artifactId>JFrame</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jframe_main</artifactId>

    <properties>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JFrame 框架模块：本模块聚合所有子模块，对外提供统一入口 -->
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_thread</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_form</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_event</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_command</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_inventory</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.JiangHu.jframe</groupId>
            <artifactId>jframe_data</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!--
              maven-shade-plugin：把 jframe 各子模块与 Spring 打包成单个可部署的「前置插件」jar。
              Nukkit（服务端）与 Lombok（编译期）不打包。
              产物 jframe_main.jar 可直接放入服务器 plugins 目录，供其他插件 depend 使用。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- 由服务端提供 -->
                                    <exclude>cn.nukkit:Nukkit</exclude>
                                    <!-- 编译期注解处理器，运行时不需要 -->
                                    <exclude>org.projectlombok:lombok</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <!-- 合并 META-INF/services（Spring 等可能用到） -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- 合并 Spring 的 schema/handlers 映射，避免 XML 解析失败 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.handlers</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.schemas</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
